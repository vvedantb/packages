node-linker=hoisted
auto-install-peers=true
# Build dependencies one at a time. With the hoisted linker, pnpm 10 copies a
# built package to its other locations by relative path in a worker thread, and
# applying a patch changes the working directory of the whole process. When the
# two overlap, files land under the patched package and the copies lose files
# (seen on Linux CI once the repository had patched dependencies).
child-concurrency=1

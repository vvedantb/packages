{
  "$source": "app-d packages/backend: convex/mcp/native.ts + nodeActions.ts (legacy HS256 tokens with iss=app-d, else Clerk), tests/mcpOauth.test.ts (tools/list body, initialize with protocolVersion 2025-03-26, tokens oat_clerk_token / oat_bad / legacy JWT, Accept header), docs/app-d-mcp.md. SDK responses: sdk/app-d.sdk.json (SDK 1.32.1, no parsedBody).",
  "bodyMode": "text",
  "cors": {
    "access-control-allow-origin": "*",
    "access-control-allow-methods": "GET,POST,DELETE,OPTIONS",
    "access-control-allow-headers": "Authorization, Content-Type, Accept, MCP-Protocol-Version, MCP-Session-Id",
    "access-control-allow-credentials": "false",
    "access-control-expose-headers": "WWW-Authenticate, MCP-Session-Id"
  },
  "endpoints": [
    {
      "path": "/mcp",
      "handler": "mcpHandler",
      "serverInfo": {
        "name": "app-d-mcp",
        "version": "1.2.0"
      },
      "exchanges": [
        {
          "name": "initialize",
          "origin": "sdk-captured",
          "token": "oat_clerk_token",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
              "protocolVersion": "2025-03-26",
              "capabilities": {},
              "clientInfo": {
                "name": "fixture-client",
                "version": "1.0.0"
              }
            }
          },
          "sdkExchange": "initialize"
        },
        {
          "name": "notifications/initialized",
          "origin": "sdk-captured",
          "token": "oat_clerk_token",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "method": "notifications/initialized"
          },
          "sdkExchange": "initialized"
        },
        {
          "name": "tools/list",
          "origin": "sdk-captured",
          "token": "oat_clerk_token",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/list",
            "params": {}
          },
          "sdkExchange": "toolsList"
        },
        {
          "name": "tools/call success",
          "origin": "sdk-captured",
          "token": "oat_clerk_token",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 4,
            "method": "tools/call",
            "params": {
              "name": "echo",
              "arguments": {
                "text": "hi"
              }
            }
          },
          "sdkExchange": "toolsCallOk"
        },
        {
          "name": "tools/call handler error",
          "origin": "sdk-captured",
          "token": "oat_clerk_token",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 5,
            "method": "tools/call",
            "params": {
              "name": "fails",
              "arguments": {}
            }
          },
          "sdkExchange": "toolsCallThrows"
        },
        {
          "name": "tools/call unknown tool",
          "origin": "sdk-captured",
          "token": "oat_clerk_token",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 7,
            "method": "tools/call",
            "params": {
              "name": "nope",
              "arguments": {}
            }
          },
          "sdkExchange": "toolsCallUnknown"
        },
        {
          "name": "ping",
          "origin": "sdk-captured",
          "token": "oat_clerk_token",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "ping"
          },
          "sdkExchange": "ping"
        },
        {
          "name": "tools/list with a legacy app-d token",
          "origin": "sdk-captured",
          "token": "legacy:user_legacy_bob",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/list",
            "params": {}
          },
          "sdkExchange": "toolsList"
        },
        {
          "name": "missing token",
          "origin": "synthesised",
          "token": null,
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/list",
            "params": {}
          },
          "expect": {
            "status": 401,
            "wwwAuthenticate": "https://happy-otter-123.convex.site/.well-known/oauth-protected-resource",
            "body": "{\"error\":\"Missing Authorization header\"}"
          }
        },
        {
          "name": "token rejected",
          "origin": "synthesised",
          "token": "oat_bad",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/list",
            "params": {}
          },
          "expect": {
            "status": 401,
            "wwwAuthenticate": "https://happy-otter-123.convex.site/.well-known/oauth-protected-resource",
            "body": "{\"error\":\"Invalid or expired token\"}"
          }
        },
        {
          "name": "GET is 405 after auth",
          "origin": "synthesised",
          "token": "oat_clerk_token",
          "method": "GET",
          "expect": {
            "status": 405,
            "body": "{\"error\":\"Method not supported in stateless mode\"}"
          }
        },
        {
          "name": "bad JSON is 400",
          "origin": "synthesised",
          "token": "oat_clerk_token",
          "method": "POST",
          "request": "{not json",
          "expect": {
            "status": 400,
            "body": "{\"error\":\"Invalid JSON body\"}"
          }
        }
      ]
    }
  ],
  "sdkCapture": "sdk/app-d.sdk.json"
}

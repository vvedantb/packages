{
  "$source": "app-a packages/backend: convex/mcp/native.ts + nodeActions.ts (HTTP layer, handleMcpRequest), tests/mcp/client.ts (McpClient request shape: params defaulted to {}, initialize with protocolVersion 2025-03-26, Accept header), tests/mcp/inProcess.ts (401 WWW-Authenticate per scope). SDK responses: sdk/app-a.sdk.json (SDK 1.29.0). clientInfo and tool names (echo, fails) are the capture script's, not app-a's.",
  "bodyMode": "json",
  "cors": {},
  "endpoints": [
    {
      "path": "/mcp",
      "handler": "mcpHandler",
      "serverInfo": {
        "name": "app-a-mcp",
        "version": "2.0.0"
      },
      "exchanges": [
        {
          "name": "initialize",
          "origin": "sdk-captured",
          "token": "good",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
              "protocolVersion": "2025-03-26",
              "capabilities": {},
              "clientInfo": {
                "name": "fixture-client",
                "version": "1.0.0"
              }
            }
          },
          "sdkExchange": "initialize"
        },
        {
          "name": "notifications/initialized",
          "origin": "sdk-captured",
          "token": "good",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "method": "notifications/initialized"
          },
          "sdkExchange": "initialized"
        },
        {
          "name": "tools/list",
          "origin": "sdk-captured",
          "token": "good",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/list",
            "params": {}
          },
          "sdkExchange": "toolsList"
        },
        {
          "name": "tools/call success",
          "origin": "sdk-captured",
          "token": "good",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 4,
            "method": "tools/call",
            "params": {
              "name": "echo",
              "arguments": {
                "text": "hi"
              }
            }
          },
          "sdkExchange": "toolsCallOk"
        },
        {
          "name": "tools/call handler error",
          "origin": "sdk-captured",
          "token": "good",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 5,
            "method": "tools/call",
            "params": {
              "name": "fails",
              "arguments": {}
            }
          },
          "sdkExchange": "toolsCallThrows"
        },
        {
          "name": "tools/call unknown tool",
          "origin": "sdk-captured",
          "token": "good",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 7,
            "method": "tools/call",
            "params": {
              "name": "nope",
              "arguments": {}
            }
          },
          "sdkExchange": "toolsCallUnknown"
        },
        {
          "name": "ping",
          "origin": "sdk-captured",
          "token": "good",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "ping"
          },
          "sdkExchange": "ping"
        },
        {
          "name": "missing token",
          "origin": "synthesised",
          "token": null,
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/list",
            "params": {}
          },
          "expect": {
            "status": 401,
            "wwwAuthenticate": "https://happy-otter-123.convex.site/.well-known/oauth-protected-resource",
            "body": "{\"error\":\"Missing Authorization header\"}"
          }
        },
        {
          "name": "token rejected",
          "origin": "synthesised",
          "token": "bad",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/list",
            "params": {}
          },
          "expect": {
            "status": 401,
            "wwwAuthenticate": "https://happy-otter-123.convex.site/.well-known/oauth-protected-resource",
            "body": "{\"error\":\"Invalid or expired token\"}"
          }
        },
        {
          "name": "GET is 405 after auth",
          "origin": "synthesised",
          "token": "good",
          "method": "GET",
          "expect": {
            "status": 405,
            "body": "{\"error\":\"Method not supported in stateless mode\"}"
          }
        },
        {
          "name": "bad JSON is 400",
          "origin": "synthesised",
          "token": "good",
          "method": "POST",
          "request": "{not json",
          "expect": {
            "status": 400,
            "body": "{\"error\":\"Invalid JSON body\"}"
          }
        }
      ]
    },
    {
      "path": "/mcp/team",
      "handler": "mcpTeamHandler",
      "serverInfo": {
        "name": "app-a-mcp-team",
        "version": "2.0.0"
      },
      "exchanges": [
        {
          "name": "initialize (team)",
          "origin": "sdk-captured, serverInfo name changed to app-a-mcp-team as mcpServerInfo(\"team\") does",
          "token": "good",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
              "protocolVersion": "2025-03-26",
              "capabilities": {},
              "clientInfo": {
                "name": "fixture-client",
                "version": "1.0.0"
              }
            }
          },
          "sdkExchange": "initialize"
        },
        {
          "name": "missing token",
          "origin": "synthesised",
          "token": null,
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/list",
            "params": {}
          },
          "expect": {
            "status": 401,
            "wwwAuthenticate": "https://happy-otter-123.convex.site/.well-known/oauth-protected-resource/mcp/team",
            "body": "{\"error\":\"Missing Authorization header\"}"
          }
        },
        {
          "name": "token rejected",
          "origin": "synthesised",
          "token": "bad",
          "method": "POST",
          "request": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/list",
            "params": {}
          },
          "expect": {
            "status": 401,
            "wwwAuthenticate": "https://happy-otter-123.convex.site/.well-known/oauth-protected-resource/mcp/team",
            "body": "{\"error\":\"Invalid or expired token\"}"
          }
        },
        {
          "name": "GET is 405 after auth",
          "origin": "synthesised",
          "token": "good",
          "method": "GET",
          "expect": {
            "status": 405,
            "body": "{\"error\":\"Method not supported in stateless mode\"}"
          }
        },
        {
          "name": "bad JSON is 400",
          "origin": "synthesised",
          "token": "good",
          "method": "POST",
          "request": "{not json",
          "expect": {
            "status": 400,
            "body": "{\"error\":\"Invalid JSON body\"}"
          }
        }
      ]
    }
  ],
  "sdkCapture": "sdk/app-a.sdk.json"
}

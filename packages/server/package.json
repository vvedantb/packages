{
  "name": "@vvedantb/server",
  "version": "0.4.1",
  "license": "MIT",
  "description": "Shared Convex backend helpers, MCP server scaffolding and Node-side MCP OAuth client helpers from one root import: query-limit errors, Clerk auth and token verification, Clerk-user lookups and ensure-user for Convex functions, bearer tokens, env, CORS, JSON responses, MCP route registration, a bearer-auth MCP HTTP handler, OAuth metadata, a JSON-RPC dispatcher, explorer tools, WebCrypto primitives, Convex optimistic-update helpers, and MCP OAuth client helpers (provider, sign-in, refresh, revocation, loopback redirect server) for desktop apps.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvedantb/packages.git",
    "directory": "packages/server"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/convex.md",
    "docs/crypto.md",
    "docs/mcp.md",
    "docs/mcp-oauth-client.md",
    "docs/migration.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run && node --test tests-node/esm-exports.mjs tests-node/bundle.mjs",
    "prepack": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@clerk/backend": ">=1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "convex": "^1.24.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@clerk/backend": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "convex": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.0.0",
    "convex": "^1.47.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0",
    "zod3": "npm:zod@^3.25.76"
  }
}

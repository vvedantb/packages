{
  "name": "@vvedantb/ui",
  "version": "0.19.1",
  "license": "MIT",
  "description": "Shared React 19 UI for web apps: one JavaScript entry (primitives, shell pieces, app helpers including the Convex and Clerk provider, VITE env parsing and ensure-user, artifact viewers over the @vvedantb/server artifacts core, native tokens), design-token CSS, shared Tailwind v4 CSS and a Tailwind preset.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvedantb/ui.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": "./tokens/src/tokens.css",
    "./tokens/tokens.css": "./tokens/src/tokens.css",
    "./tokens/css/index.css": "./tokens/src/css/index.css",
    "./tokens/css/base.css": "./tokens/src/css/base.css",
    "./tokens/css/dialog.css": "./tokens/src/css/dialog.css",
    "./tokens/css/modal.css": "./tokens/src/css/modal.css",
    "./tokens/css/tabs.css": "./tokens/src/css/tabs.css",
    "./tokens/css/tabs-pills.css": "./tokens/src/css/tabs-pills.css",
    "./tokens/css/utilities.css": "./tokens/src/css/utilities.css",
    "./tokens/css/scrollbar-thin.css": "./tokens/src/css/scrollbar-thin.css",
    "./tokens/css/clear-input.css": "./tokens/src/css/clear-input.css",
    "./tokens/css/motion.css": "./tokens/src/css/motion.css",
    "./tokens/css/animations.css": "./tokens/src/css/animations.css",
    "./tokens/css/nav-icons.css": "./tokens/src/css/nav-icons.css",
    "./tokens/css/compat-shadcn-rgb.css": "./tokens/src/css/compat-shadcn-rgb.css",
    "./tokens/css/border-beam.css": "./tokens/src/css/border-beam.css",
    "./tokens/css/markdown.css": "./tokens/src/css/markdown.css",
    "./tokens/compat/shadcn-rgb.css": "./tokens/src/css/compat-shadcn-rgb.css",
    "./tokens/css/*.css": "./tokens/src/css/*.css",
    "./tokens/tailwind-preset": {
      "types": "./tokens/src/tailwind-preset.d.mts",
      "default": "./tokens/src/tailwind-preset.mjs"
    },
    "./landing.css": "./src/marketing/landing.css",
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "shell/src/**/*.{ts,tsx}",
    "app/src",
    "tokens/src",
    "tokens/examples",
    "README.md",
    "LICENSE",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "sideEffects": [
    "./src/ui/sonner.css",
    "./src/marketing/landing.css"
  ],
  "scripts": {
    "check:tokens": "node tokens/scripts/check-component-tokens.mjs",
    "build": "node tokens/scripts/check-exports.mjs && node tokens/scripts/check-component-tokens.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.consumer.json && tsc -p tsconfig.consumer-speech.json && tsc -p tokens/tsconfig.json",
    "test": "node tokens/scripts/check-component-tokens.mjs && vitest run && node --test tokens/test/*.test.mjs app/tests-node/*.test.mjs",
    "verify": "node tokens/scripts/check-component-tokens.mjs && node tokens/verify/run.mjs",
    "analyze": "node tokens/verify/analyze.mjs",
    "prepack": "node tokens/scripts/check-exports.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",

    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.24.0",
    "embla-carousel-react": "^8.6.0",
    "motion": ">=12.0.0",
    "nanoid": "^5.1.0",
    "radix-ui": "^1.4.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "shiki": "^3.0.0",
    "sonner": "^2.0.3",

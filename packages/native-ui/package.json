{
  "name": "@vvedantb/native-ui",
  "version": "0.3.0",
  "license": "MIT",
  "description": "Shared React Native / Expo UI primitives. Floating surfaces, forms, overlays, toasts, settings chrome, tab bar and the family app marks.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvedantb/ui.git",
    "directory": "packages/native-ui"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./gallery": {
      "types": "./src/examples/ParityGallery.tsx",
      "default": "./src/examples/ParityGallery.tsx"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').accessSync('src/index.ts')\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepack": "node -e \"require('node:fs').accessSync('src/index.ts')\""
  },
  "peerDependencies": {
    "@expo/vector-icons": "*",
    "@gorhom/bottom-sheet": ">=5",
    "@react-native-community/datetimepicker": "*",
    "@rn-primitives/select": "*",
    "@rn-primitives/slot": "*",
    "@rn-primitives/switch": "*",
    "@tabler/icons-react-native": "*",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "dayjs": ">=1.11.0",
    "expo-blur": "*",
    "expo-haptics": "*",
    "expo-linear-gradient": "*",
    "expo-router": "*",
    "lucide-react-native": "*",
    "nativewind": ">=4.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.76.0",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "react-native-svg": "*",
    "tailwind-merge": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "@react-native-community/datetimepicker": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').accessSync('src/index.ts')\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json && pnpm run typecheck:consumer",
    "typecheck:consumer": "tsc -p tsconfig.consumer.json",
    "prepack": "node -e \"require('node:fs').accessSync('src/index.ts')\""
  },

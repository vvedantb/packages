{
  "name": "@vvedantb/app-kit",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Shared web app helpers: Alt-click confirm skip, update-available watcher, settings chrome and a stable Clerk auth hook.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvedantb/ui.git",
    "directory": "packages/app-kit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@clerk/clerk-react": ">=5",
    "@tanstack/react-hotkeys": "*",
    "react": ">=19",
    "react-dom": ">=19",
    "zod": ">=3"
  },
  "devDependencies": {
    "@clerk/clerk-react": "^5.0.0",
    "@tanstack/react-hotkeys": "^0.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "happy-dom": "^18.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  }
}

{
  "name": "@vvedantb/mcp-client",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Node-side MCP client OAuth for desktop apps from one root import: an OAuthClientProvider over injected storage, sign-in, refresh and revocation, and a 127.0.0.1 loopback redirect server.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvedantb/packages.git",
    "directory": "packages/mcp-client"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run && node --test tests-node/esm-exports.mjs",
    "prepack": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.6",
    "zod3": "npm:zod@^3.25.76"
  }
}

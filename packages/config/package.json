{
  "name": "@vvedantb/config",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Shared tsconfig bases, oxlint base, pinned tool versions, a sync CLI for Claude commands, CLAUDE.md, Cursor environment and Convex tsconfig, and a packaged Electron app.asar module check.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvedantb/packages.git",
    "directory": "packages/config"
  },
  "bin": {
    "vvedantb-config": "./dist/cli.js",
    "vvedantb-check-asar": "./dist/check-asar-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/web.json": "./tsconfig/web.json",
    "./tsconfig/convex.json": "./tsconfig/convex.json",
    "./tsconfig/react-native.json": "./tsconfig/react-native.json",
    "./oxlint/base.json": "./oxlint/base.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "files",
    "tsconfig",
    "oxlint",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@electron/asar": "^3.2.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@electron/asar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^3.2.0"
  }
}

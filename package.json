{
  "name": "packages",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "pnpm -r --filter './packages/**' --if-present run test && pnpm test:scripts",
    "typecheck": "pnpm -r --filter './packages/**' --if-present run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:dry-run": "pnpm build && node scripts/release-dry-run.mjs",
    "ci:publish": "pnpm build && pnpm typecheck && pnpm test && changeset publish",
    "agent": "node scripts/agent.mjs",
    "test:scripts": "node --test \"scripts/agent/*.test.mjs\""
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3"
  }
}

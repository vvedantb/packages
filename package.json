{
  "name": "packages",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "lint:tests": "node scripts/check-no-source-text-in-tests.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test": "pnpm run lint:tests && pnpm run test:scripts && pnpm -r --filter './packages/**' --if-present run test",
    "typecheck": "pnpm -r --filter './packages/**' --if-present run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:dry-run": "pnpm build && node scripts/release-dry-run.mjs",
    "ci:publish": "pnpm build && pnpm typecheck && pnpm test && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3"
  }
}

    "@rn-primitives/select": "^1.3.0",
    "@rn-primitives/slot": "^1.3.0",
    "@rn-primitives/switch": "^1.3.0",
    "@tabler/icons-react-native": "^3.35.0",
    "@vvedantb/native-ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.27.0",
    "dayjs": "^1.11.18",
    "expo": "~57.0.32",
    "expo-auth-session": "~57.0.16",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.23",
    "expo-device": "~57.0.2",

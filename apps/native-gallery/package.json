{
  "name": "native-gallery",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android": "expo prebuild --platform android --no-install && cd android && NODE_PATH=\"$(cd ../../.. && pwd)/node_modules/.pnpm/node_modules\" ./gradlew assembleRelease -PreactNativeArchitectures=x86_64",
    "export:android": "expo export --platform android",
    "typecheck": "tsc --noEmit",
    "maestro": "maestro test --format junit --output maestro-report.xml .maestro"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.0",

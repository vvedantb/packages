{
  "name": "native-gallery",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android": "expo prebuild --platform android --no-install && cd android && NODE_PATH=\"$(cd ../../.. && pwd)/node_modules\" ./gradlew assembleRelease -PreactNativeArchitectures=x86_64",
    "export:android": "expo export --platform android",
    "typecheck": "tsrs --noEmit --fast -p tsconfig.json",
    "maestro": "maestro test --format junit --output maestro-report.xml .maestro",
    "build:android:agent": "EXPO_PUBLIC_NATIVE_UI_AGENT=1 expo prebuild --platform android --no-install && cd android && NODE_PATH=\"$(cd ../../.. && pwd)/node_modules\" EXPO_PUBLIC_NATIVE_UI_AGENT=1 ./gradlew assembleRelease -PreactNativeArchitectures=x86_64",
    "e2e:android": "node e2e/run.mjs",
    "test": "node --test tests/clock.test.mjs",
    "test:strip": "node --test --test-timeout=1200000 tests/strip.test.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@json-render/core": "0.21.0",
    "@json-render/react-native": "0.21.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@rn-primitives/portal": "^1.3.0",
    "@rn-primitives/select": "^1.3.0",
    "@rn-primitives/slot": "^1.3.0",
    "@rn-primitives/switch": "^1.3.0",
    "@swmansion/react-native-bottom-sheet": "1.1.0",
    "@tabler/icons-react-native": "^3.35.0",
    "@vvedantb/native-ui": "workspace:*",
    "@vvedantb/server": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.27.0",
    "dayjs": "^1.11.18",
    "expo": "~58.0.26",
    "expo-auth-session": "~58.0.19",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-paste-input": "0.2.2",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.1.0",
    "lucide-react-native": "^0.545.0",
    "nativewind": "^4.2.1",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-marked": "^8.0.0",
    "react-native-reanimated": "4.8.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.14.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@types/react": "^19.1.0",
    "babel-preset-expo": "~58.0.26",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@vvedantb/server/generative-ui": [
        "../../packages/server/src/generative-ui/index.ts"
      ],
      "react-native": [
        "../../node_modules/react-native/types_generated/index.d.ts"
      ],
      "react-native/*": [
        "../../node_modules/react-native/types_generated/*",
        "../../node_modules/react-native/*"
      ],
      "*": [
        "./node_modules/@types/*",
        "../../node_modules/@types/*",
        "./node_modules/*"
      ]
    }
  },
  "include": [
    "app",
    "src",
    "*.d.ts",
    "nativewind-env.d.ts"
  ]
}
